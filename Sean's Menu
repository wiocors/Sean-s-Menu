local function CreateSlider(parent, title, minimum, maximum, default, position, callback)
    local card = CreateCard(
        parent,
        position,
        UDim2.new(1, -36, 0, 70)
    )

    CreateLabel(
        card,
        title,
        UDim2.fromOffset(13, 8),
        UDim2.new(0.7, 0, 0, 18),
        12
    )

    local valueLabel = CreateLabel(
        card,
        tostring(default),
        UDim2.new(1, -65, 0, 8),
        UDim2.fromOffset(50, 18),
        12
    )

    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("TextButton")
    track.Position = UDim2.fromOffset(13, 42)
    track.Size = UDim2.new(1, -26, 0, 7)
    track.Text = ""
    track.AutoButtonColor = false
    track.BorderSizePixel = 0
    track.Parent = card

    Colorize(track, "BackgroundColor3", "Surface2")
    Corner(track, 10)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((default - minimum) / (maximum - minimum), 1)
    fill.BorderSizePixel = 0
    fill.Parent = track

    Colorize(fill, "BackgroundColor3", "Accent")
    Corner(fill, 10)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new((default - minimum) / (maximum - minimum), 0, 0.5, 0)
    knob.BorderSizePixel = 0
    knob.Parent = track

    Colorize(knob, "BackgroundColor3", "White")
    Corner(knob, 10)
    Outline(knob, 1)

    local function SetValue(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local percent = math.clamp(
            (x - track.AbsolutePosition.X) / width,
            0,
            1
        )

        local value = math.floor(
            minimum + (maximum - minimum) * percent + 0.5
        )

        local normalized = (value - minimum) / (maximum - minimum)

        fill.Size = UDim2.fromScale(normalized, 1)
        knob.Position = UDim2.new(normalized, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        callback(value)
    end

    local function Begin(input)
        ActiveSlider = SetValue
        SetValue(input.Position.X)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            Begin(input)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            Begin(input)
        end
    end)

    return function(value)
        local normalized = (value - minimum) / (maximum - minimum)

        fill.Size = UDim2.fromScale(normalized, 1)
        knob.Position = UDim2.new(normalized, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
    end
end

UIS.InputChanged:Connect(function(input)
    if ActiveSlider and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        ActiveSlider(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        ActiveSlider = nil
    end
end)

