local ThemeNames = {"Red", "Blue", "Purple", "Green", "Pink"}
local CurrentTheme = "Red"
local Theme = Themes[CurrentTheme]

local ThemeBindings = {}
local Highlights = {}

local function Colorize(object, property, role)
    object[property] = Theme[role]

    table.insert(ThemeBindings, {
        Object = object,
        Property = property,
        Role = role
    })
end

local function ApplyTheme()
    Theme = Themes[CurrentTheme]

    for _, binding in ipairs(ThemeBindings) do
        if binding.Object and binding.Object.Parent then
            binding.Object[binding.Property] = Theme[binding.Role]
        end
    end

    for _, highlight in pairs(Highlights) do
        if highlight and highlight.Parent then
            highlight.FillColor = Theme.Accent
            highlight.OutlineColor = Theme.White
        end
    end

    if ThemeButton then
        ThemeButton.Text = "THEME: " .. string.upper(CurrentTheme) .. "  >"
    end

    if Subtitle then
        Subtitle.Text = string.upper(CurrentTheme) .. " EDITION"
    end
end

local function NextTheme()
    local index = table.find(ThemeNames, CurrentTheme) or 1
    index = index % #ThemeNames + 1
    CurrentTheme = ThemeNames[index]
    ApplyTheme()
end

