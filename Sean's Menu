--========================================================
-- OPEN / CLOSE
--========================================================

function HideMenu()
    if not MenuOpen then return end
    MenuOpen = false

    local tween = MakeTween(Main, 0.25, {
        Position = UDim2.new(0.5, -305, 1.2, 0)
    }, Enum.EasingStyle.Quint)

    tween.Completed:Wait()

    Main.Visible = false
    ReopenButton.Visible = true

    MakeTween(ReopenButton, 0.3, {
        Position = UDim2.new(0, 20, 0.5, -25)
    }, Enum.EasingStyle.Back)
end

function ShowMenu()
    if MenuOpen then return end
    MenuOpen = true

    MakeTween(ReopenButton, 0.18, {
        Position = UDim2.new(0, -65, 0.5, -25)
    })

    task.wait(0.18)

    ReopenButton.Visible = false
    Main.Visible = true
    Main.Position = UDim2.new(0.5, -305, 1.2, 0)

    MakeTween(Main, 0.35, {
        Position = UDim2.new(0.5, -305, 0.5, -215)
    }, Enum.EasingStyle.Back)
end

MinimizeButton.MouseButton1Click:Connect(HideMenu)
CloseButton.MouseButton1Click:Connect(HideMenu)
ReopenButton.MouseButton1Click:Connect(ShowMenu)

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.RightShift then
        if MenuOpen then
            HideMenu()
