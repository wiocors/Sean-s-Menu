--========================================================
-- NAVIGATION
--========================================================

local NavButtons = {}

local function SwitchPage(name)
    if CurrentPage == name then return end

    local oldPage = Pages[CurrentPage]
    local newPage = Pages[name]

    if not newPage then return end

    if oldPage then
        oldPage.Visible = false
    end

    CurrentPage = name
    newPage.Visible = true
    newPage.Position = UDim2.fromOffset(14, 0)

    MakeTween(newPage, 0.22, {
        Position = UDim2.fromOffset(0, 0)
    })

    for pageName, button in pairs(NavButtons) do
        local selected = pageName == name

        MakeTween(button, 0.15, {
            BackgroundColor3 = selected and Theme.Accent or Theme.Surface2,
            TextColor3 = selected and Theme.White or Theme.Gray
        })
    end
end

local function CreateNavButton(name, order)
    local button = Instance.new("TextButton")
    button.Name = name .. "Button"
    button.Size = UDim2.new(1, 0, 0, 40)
    button.LayoutOrder = order
    button.Text = name
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 12
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Parent = Sidebar

    Colorize(button, "BackgroundColor3", "Surface2")
    Colorize(button, "TextColor3", "Gray")

    Corner(button, 8)
    Outline(button, 1)

    NavButtons[name] = button

    button.MouseEnter:Connect(function()
        if CurrentPage ~= name then
            MakeTween(button, 0.12, {
                BackgroundColor3 = Theme.Accent,
                TextColor3 = Theme.White
            })
        end
    end)

    button.MouseLeave:Connect(function()
        if CurrentPage ~= name then
            MakeTween(button, 0.12, {
                BackgroundColor3 = Theme.Surface2,
                TextColor3 = Theme.Gray
            })
        end
    end)

    button.MouseButton1Click:Connect(function()
        SwitchPage(name)
    end)

    return button
end

